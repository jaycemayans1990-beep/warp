local function IsSameTeam(player)
    if player.Team ~= nil and LocalPlayer.Team ~= nil then
        return player.Team == LocalPlayer.Team
    end
    return player.TeamColor == LocalPlayer.TeamColor
end

-- อัปเดตรายชื่อแบบประหยัดทรัพยากร
function RefreshPlayers()
    for _, child in ipairs(PlayerListScroll:GetChildren()) do
        if child:IsA("TextButton") then
            child:Destroy()
        end
    end

    local count = 0
    local targetStillExists = false

    for _, player in ipairs(Players:GetPlayers()) do
        if player ~= LocalPlayer then
            local sameTeam = IsSameTeam(player)
            local show = (FilterMode == "Enemy" and not sameTeam) or (FilterMode == "Team" and sameTeam)

            if show then
                count = count + 1
                if player.Name == SelectedPlayerName then
                    targetStillExists = true
                end

                local pBtn = Instance.new("TextButton")
                pBtn.Parent = PlayerListScroll
                pBtn.BackgroundColor3 = sameTeam and Color3.fromRGB(30, 50, 35) or Color3.fromRGB(50, 30, 35)
                pBtn.Size = UDim2.new(1, -6, 0, 28)
                pBtn.Font = Enum.Font.Gotham
                pBtn.Text = player.Name .. (sameTeam and " [ทีมเรา]" or " [ศัตรู]")
                pBtn.TextColor3 = sameTeam and Color3.fromRGB(100, 255, 100) or Color3.fromRGB(255, 100, 100)
                pBtn.TextSize = 11

                Instance.new("UICorner", pBtn).CornerRadius = UDim.new(0, 4)

                pBtn.MouseButton1Click:Connect(function()
                    SelectedPlayerName = player.Name
                    SelectedLabel.Text = "เป้าหมาย: " .. player.Name
                end)
            end
        end
    end

    if not targetStillExists and SelectedPlayerName ~= "" then
        SelectedPlayerName = ""
        SelectedLabel.Text = "เป้าหมาย: ยังไม่ได้เลือก"
    end

    PlayerListScroll.CanvasSize = UDim2.new(0, 0, 0, count * 31)
end

