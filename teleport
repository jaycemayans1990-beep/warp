-- ฟังก์ชันเช็กว่าอยู่ทีมเดียวกันหรือไม่
local function IsSameTeam(player)
    if player.Team ~= nil and LocalPlayer.Team ~= nil then
        return player.Team == LocalPlayer.Team
    end
    return player.TeamColor == LocalPlayer.TeamColor
end

function RefreshPlayers()
    for _, child in ipairs(PlayerListScroll:GetChildren()) do
        if child:IsA("TextButton") then
            child:Destroy()
        end
    end

    local count = 0
    for _, player in ipairs(Players:GetPlayers()) do
        if player ~= LocalPlayer then
            local sameTeam = IsSameTeam(player)
            local show = false

            if FilterMode == "All" then
                show = true
            elseif FilterMode == "Enemy" and not sameTeam then
                show = true
            elseif FilterMode == "Team" and sameTeam then
                show = true
            end

            if show then
                count = count + 1
                local pBtn = Instance.new("TextButton")
                local btnCorner = Instance.new("UICorner")

                pBtn.Parent = PlayerListScroll
                pBtn.BackgroundColor3 = sameTeam and Color3.fromRGB(30, 50, 35) or Color3.fromRGB(50, 30, 35)
                pBtn.Size = UDim2.new(1, -6, 0, 28)
                pBtn.Font = Enum.Font.Gotham
                pBtn.Text = player.Name .. (sameTeam and " [ทีมเรา]" or " [ศัตรู]")
                pBtn.TextColor3 = sameTeam and Color3.fromRGB(100, 255, 100) or Color3.fromRGB(255, 100, 100)
                pBtn.TextSize = 11

                btnCorner.CornerRadius = UDim.new(0, 4)
                btnCorner.Parent = pBtn

                pBtn.MouseButton1Click:Connect(function()
                    SelectedPlayerName = player.Name
                    SelectedLabel.Text = "เป้าหมาย: " .. player.Name
                end)
            end
        end
    end

    PlayerListScroll.CanvasSize = UDim2.new(0, 0, 0, count * 31)
    if count == 0 then
        SelectedLabel.Text = "เป้าหมาย: ไม่พบผู้เล่นในโหมดนี้"
    end
end

