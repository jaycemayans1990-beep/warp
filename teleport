local filterButtons = {}

local function createFilterBtn(text, mode)
    local btn = Instance.new("TextButton")
    local corner = Instance.new("UICorner")
    
    btn.Parent = FilterFrame
    btn.Size = UDim2.new(0.31, 0, 1, 0)
    btn.Font = Enum.Font.GothamBold
    btn.Text = text
    btn.TextSize = 10
    btn.TextColor3 = (FilterMode == mode) and Color3.fromRGB(255, 255, 255) or Color3.fromRGB(150, 150, 150)
    btn.BackgroundColor3 = (FilterMode == mode) and Color3.fromRGB(0, 170, 255) or Color3.fromRGB(40, 40, 50)
    
    corner.CornerRadius = UDim.new(0, 4)
    corner.Parent = btn
    
    filterButtons[mode] = btn
    
    btn.MouseButton1Click:Connect(function()
        FilterMode = mode
        for m, b in pairs(filterButtons) do
            b.BackgroundColor3 = (m == FilterMode) and Color3.fromRGB(0, 170, 255) or Color3.fromRGB(40, 40, 50)
            b.TextColor3 = (m == FilterMode) and Color3.fromRGB(255, 255, 255) or Color3.fromRGB(150, 150, 150)
        end
        RefreshPlayers()
    end)
end

