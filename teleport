local function createFilterBtn(text, mode)
    local btn = Instance.new("TextButton")
    btn.Parent = FilterFrame
    btn.Size = UDim2.new(0.48, 0, 1, 0)
    btn.Font = Enum.Font.GothamBold
    btn.Text = text
